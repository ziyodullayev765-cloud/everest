# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit real values.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The public "anon" key (or the newer "publishable" key). Safe for the browser:
# Row Level Security decides what it can do.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public URL of the site (canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Random secret used to hash visitor IPs for contact-form rate limiting.
# Generate with: openssl rand -hex 32
CONTACT_IP_SALT=change-me

# ---------------------------------------------------------------------------
# ONLY for the one-off admin setup script (npm run admin:create).
# Server-side secret that bypasses RLS. Do NOT add it to your hosting
# provider's environment and never prefix it with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# Push notifications for the admin (new contact messages). Generate the pair with
# `npx web-push generate-vapid-keys`; PUSH_SECRET is any random 64-hex string whose
# SHA-256 hash goes into public.push_config (see the push_subscriptions migration).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_SECRET=
VAPID_SUBJECT=

# Optional: e-mail copy of each contact message via Resend (https://resend.com).
# CONTACT_NOTIFY_EMAIL is where messages go. With the default sender
# (onboarding@resend.dev) Resend only delivers to your own Resend account e-mail.
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
RESEND_FROM=

# Optional: reply to contact messages by e-mail straight from Admin → Messages.
# Any SMTP account works. For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_USER=your@gmail.com, SMTP_PASS=a Google "app password" (not your normal password).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
