# Copy to .env.local (dev) or set in your host. Never commit real values.

# PostgreSQL connection string (server only). Any Postgres 14+ works: Neon, Supabase DB, Render, RDS, self-hosted.
# Use the pooled URL on serverless hosts (e.g. Neon "-pooler" host or Supabase port 6543).
DATABASE_URL=postgres://learn:learn@localhost:5432/learn_dev

# Public base URL, no trailing slash. Used for reset links and metadata.
APP_URL=http://localhost:3100

# Random 32+ byte secret (openssl rand -hex 32). Used to hash IPs for rate limiting / audit logs.
APP_SECRET=change-me-to-a-long-random-string

# Optional: maximum upload size in bytes (default 4 MB — Vercel functions cap request bodies at ~4.5 MB).
MAX_UPLOAD_BYTES=4194304

# Optional e-mail delivery (NOT configured by default; in-app notifications always work).
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# MAIL_FROM="Everest <no-reply@example.com>"
