{
  "name": "everest-learn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "admin:create": "tsx --conditions=react-server scripts/create-admin.ts",
    "icons": "node scripts/make-icons.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "vercel-build": "node scripts/vercel-build.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@vercel/blob": "^2.8.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "geist": "^1.8.1",
    "katex": "^0.19.0",
    "lucide-react": "^1.61.0",
    "next": "^15.5.28",
    "pdfjs-dist": "5.4.624",
    "postgres": "^3.4.9",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
